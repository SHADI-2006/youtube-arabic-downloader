# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — your keys never leave your machine.

# Free key from https://aistudio.google.com/apikey
# Without it, Arabic translation falls back to YouTube's own
# auto-translation, then Google Translate.
GEMINI_API_KEY=

# Path to a YouTube cookies.txt export (fixes bot-detection errors).
# Export with the "Get cookies.txt LOCALLY" browser extension.
YT_COOKIES_FILE=

# Optional — only for private Instagram accounts.
INSTAGRAM_COOKIES_FILE=
